import { useMemo, FC } from 'react';
import { renderBody, Theme } from 'markup-plus-js';

interface Props {
  source: string;
  theme?: Theme;
}

const MarkupPlus: FC<Props> = ({ source, theme = 'light' }) => {
  const html = useMemo(
    () => renderBody(source, { theme }),
    [source, theme]
  );

  return <div dangerouslySetInnerHTML={{ __html: html }} />;
};

export default MarkupPlus;