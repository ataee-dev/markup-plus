import express, { Request, Response } from 'express';
import { toHTMLAsync, Theme } from 'markup-plus-js';

const app = express();

app.get('/doc', async (req: Request, res: Response) => {
  const source = await readMarkupFile('doc.mup');
  const theme: Theme = 'github';

  const html = await toHTMLAsync(source, {
    theme,
    baseDir: './docs',
  });

  res.type('html').send(html);
});

app.listen(3000, () => {
  console.log('Server running on http://localhost:3000');
});